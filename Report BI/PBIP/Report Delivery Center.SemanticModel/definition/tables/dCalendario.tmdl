		isNameInferred
		sourceColumn: [Eh Fim de Semana]

		annotation SummarizationSetBy = Automatic

	partition dCalendario = calculated
		mode: import
		source =
				
				VAR DataMinima = DATEVALUE(MIN(fOrders[order_moment_created]))
				VAR DataMaxima = DATEVALUE(MAX(fOrders[order_moment_created]))
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(DataMinima, DataMaxima),
				        "Ano", YEAR([Date]),
				        "Numero Mes", MONTH([Date]),
				        "Mes", FORMAT([Date], "mmm"),
				        "Mes Completo", FORMAT([Date], "mmmm"),
				        "Ano Mes", FORMAT([Date], "yyyy-mm"),
				        "Ano Mes Ordenacao", YEAR([Date]) * 100 + MONTH([Date]),
				        "Trimestre", "T" & FORMAT([Date], "q"),
				        "Semana do Ano", WEEKNUM([Date], 2),
				        "Dia", DAY([Date]),
				        "Dia da Semana Num", WEEKDAY([Date], 2),
				        "Dia da Semana", FORMAT([Date], "dddd"),
				        "Dia da Semana Abreviado", FORMAT([Date], "ddd"),
				        "Eh Fim de Semana", IF(WEEKDAY([Date], 2) >= 6, "Sim", "Não")
				    )

	annotation PBI_Id = 1ae9017864d64568988e22907665f369

