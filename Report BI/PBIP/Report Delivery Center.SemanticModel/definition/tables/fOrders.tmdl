	column driver_modal_categorizado = ```
			
			VAR vModal = RELATED(dDrivers[driver_modal])
			RETURN
			SWITCH(
			    TRUE(),
			    -- 1. Possui o modal cadastrado normalmente na dDrivers
			    NOT(ISBLANK(vModal)), 
			        vModal,
			    
			    -- 2. Houve entrega e distância medida, mas o entregador não tem cadastro em dDrivers
			    NOT(ISBLANK(fOrders[delivery_distance_meters])) && ISBLANK(vModal), 
			        "Entregador Sem Cadastro",
			    
			    -- 3. Pedido concluído sem despacho/sem entrega registrada (Takeout / Entrega Própria)
			    fOrders[order_status] IN {"DELIVERED", "FINISHED"} && ISBLANK(fOrders[delivery_distance_meters]), 
			        "Retirada / Logística Própria",
			    
			    -- 4. Pedido cancelado antes de alocar motorista
			    fOrders[order_status] = "CANCELED", 
			        "Cancelado sem Alocação",
			    
			    -- Caso residual
			    "Outros / Não Informado"
			)
			```
		lineageTag: c38b4109-c8ff-46cc-babe-b7fd65e65103
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

